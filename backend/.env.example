# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Provide your MongoDB connection string (e.g. mongodb://localhost:27017/pixx_task_manager or MongoDB Atlas URI)
MONGODB_URI=

# Frontend Origin for CORS
FRONTEND_URL=http://localhost:5173

# Authentication & JWT Configuration
JWT_ACCESS_SECRET=your_super_secret_access_jwt_key_min_32_chars
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECURE=false

# Initial Administrator Seed Configuration (Run: npm run seed:admin)
INITIAL_ADMIN_EMAIL=admin@pixxtechnologiees.com
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=System Administrator

# Cloudinary Storage Configuration (Required for attachments and media uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Gmail OAuth2 (preferred for transactional email alerts)
EMAIL_USER=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REFRESH_TOKEN=
# Optional SMTP alternative, used when OAuth2 credentials are incomplete
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM=PixxTechnologiees Task Manager <notifications@pixxtechnologiees.com>

# Scheduled Reminders & Background Worker
ENABLE_SCHEDULER=true
# SCHEDULER_ENABLED=true  # Alternative alias
SCHEDULER_CRON=0 * * * *
REMINDER_DUE_SOON_HOURS=24
REMINDER_INTERVAL_MINUTES=60
SCHEDULER_TIMEZONE=UTC

# Meta WhatsApp Cloud API webhook intake
WHATSAPP_PROVIDER=auto
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GROUP_ID=
PIXX_WHATSAPP_GROUP_ID=
# WhatsApp recipient for task-created notifications (phone number, user JID, or group JID)
WHATSAPP_TASK_NOTIFICATION_JID=
AUTH_INFO_PATH=./auth_info_baileys
# Baileys listener uses this group ID, and requires MongoDB + a matching active project.
# Scan its startup QR code once to create the persistent multi-device auth state.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_API_VERSION=v22.0
WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_MAX_MEDIA_BYTES=10485760
# Twilio only (optional; required to validate Twilio signatures and fetch Twilio media)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
WHATSAPP_DEFAULT_PROJECT_ID=
WHATSAPP_DEFAULT_ASSIGNEE_ID=
