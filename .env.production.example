# Copy to .env.production, fill in real values, and protect the file.
NODE_ENV=production
PORT=5000
MONGO_USER=taskmanager
MONGO_PASSWORD=replace-with-a-long-alphanumeric-password
MONGO_URI=mongodb://taskmanager:replace-with-a-long-alphanumeric-password@mongodb:27017/pixx_task_manager?authSource=admin
OWNER_EMAIL=admin@example.com
OWNER_PASSWORD=replace-with-a-unique-password-of-at-least-8-characters
OWNER_NAME=Workspace Administrator

# Generate two independent secrets with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Production startup rejects these placeholders until both secrets are replaced.
JWT_ACCESS_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-unique-random-secret-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Backward-compatible JWT aliases:
JWT_SECRET=
JWT_EXPIRES_IN=
COOKIE_SECURE=true

FRONTEND_URL=https://tasks.example.com
# Comma-separated additional production frontend origins, if required.
FRONTEND_URLS=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Gmail OAuth2 (preferred)
EMAIL_USER=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REFRESH_TOKEN=
# Optional SMTP alternative
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM=PixxTechnologiees Tasks <notifications@example.com>

WHATSAPP_PROVIDER=meta
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GROUP_ID=
PIXX_WHATSAPP_GROUP_ID=
AUTH_INFO_PATH=./auth_info_baileys
WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_DEFAULT_PROJECT_ID=
WHATSAPP_DEFAULT_ASSIGNEE_ID=
WHATSAPP_GRAPH_API_VERSION=v22.0
WHATSAPP_MAX_MEDIA_BYTES=10485760

# Compose uses these for protected Redis and cross-worker Socket.IO delivery.
REDIS_PASSWORD=replace-with-a-long-random-redis-password
REDIS_URL=redis://:replace-with-a-long-random-redis-password@redis:6379
